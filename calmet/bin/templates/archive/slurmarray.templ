#!/bin/bash
#SBATCH --job-name=clm___DOM_____MONTH__%a	     	# Job name
#SBATCH --partition=user				# Partition (predtym class)
#SBATCH --mail-type=FAIL          			# Mail events (NONE, BEGIN, END, FAIL, ALL)
#SBATCH --nodes=1
#SBATCH --array=0-__NDAYS__                   		# Pocet taskov
#SBATCH --time=02:00:00               			# Time limit hrs:min:sec
#SBATCH --mem=3GB             				# memory limit
#SBATCH --output=__SLURMLOG__

FILES=(__INPDIR__/*)

srun calmet_ifort ${FILES[$SLURM_ARRAY_TASK_ID]}

