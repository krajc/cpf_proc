#!/bin/bash
#SBATCH --job-name=calwrf___MONTH__     	# Job name
#SBATCH -p user				# Partition (predtym class)
#SBATCH --mail-type=FAIL          	# Mail events (NONE, BEGIN, END, FAIL, ALL)
##SBATCH --nodes=1
#SBATCH --ntasks=__NDAYS__                   	# Pocet taskov
#SBATCH --cpus-per-task=1		# Pocet cpu na task
#SBATCH --error=calwrf.err	   	# Standard output and error log
#SBATCH --output=/dev/null
#SBATCH --time=01:00:00               	# Time limit hrs:min:sec
#SBATCH --mem-per-cpu=2GB             		# memory limit

srun -n__NDAYS__ -l --preserve-env --multi-prog ./multi.conf
